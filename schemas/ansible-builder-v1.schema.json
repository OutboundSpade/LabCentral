{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labcentral.io/schemas/ansible-builder-v1.schema.json",
  "title": "labcentral.ansible.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["playbook", "diskGiB", "guestUser"],
  "properties": {
    "playbook": {"type": "string", "minLength": 1, "maxLength": 240},
    "diskGiB": {"type": "integer", "minimum": 2, "maximum": 64},
    "guestUser": {"type": "string", "pattern": "^[a-z_][a-z0-9_-]{0,31}$", "not": {"const": "root"}},
    "baseURL": {"type": "string", "format": "uri", "pattern": "^https://"},
    "baseSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "baseDependency": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"}
  },
  "oneOf": [
    {"required": ["baseURL", "baseSHA256"], "not": {"required": ["baseDependency"]}},
    {"required": ["baseDependency"], "not": {"anyOf": [{"required": ["baseURL"]}, {"required": ["baseSHA256"]}]}}
  ]
}
