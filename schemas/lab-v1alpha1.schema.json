{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.io/labs/v1alpha1/lab.schema.json",
  "title": "LabCentral Lab v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "labs.labcentral.io/v1alpha1"},
    "kind": {"const": "Lab"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "spec": {"$ref": "#/$defs/spec"}
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
    "ref": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}\\.[a-z][a-z0-9-]{0,62}$"},
    "metadata": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "title": {"type": "string", "maxLength": 200},
        "description": {"type": "string", "maxLength": 4000},
        "labels": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 256}, "maxProperties": 64},
        "annotations": {"type": "object", "additionalProperties": {"type": "string", "maxLength": 4096}, "maxProperties": 64}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false, "required": ["resources"],
      "properties": {
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}, "maxItems": 128},
        "components": {"type": "array", "items": {"$ref": "#/$defs/component"}, "maxItems": 64},
        "uses": {"type": "array", "items": {"$ref": "#/$defs/componentUse"}, "maxItems": 128},
        "requirements": {"$ref": "#/$defs/requirements"},
        "resources": {"$ref": "#/$defs/resources"},
        "outputs": {"type": "array", "items": {"$ref": "#/$defs/output"}, "maxItems": 128},
        "providerOverrides": {"type": "object", "propertyNames": {"$ref": "#/$defs/name"}, "additionalProperties": {"$ref": "#/$defs/providerOverride"}, "maxProperties": 8}
      }
    },
    "parameter": {
      "type": "object", "additionalProperties": false, "required": ["name", "type"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"}, "type": {"enum": ["string", "stringList", "integer", "number", "boolean", "enum", "cidr", "ip", "duration", "secretRef"]},
        "description": {"type": "string", "maxLength": 1000}, "required": {"type": "boolean"}, "default": {},
        "enum": {"type": "array", "items": {"type": ["string", "integer"]}, "uniqueItems": true, "maxItems": 128},
        "min": {"type": "number"}, "max": {"type": "number"}, "pattern": {"type": "string", "maxLength": 512}
      }
    },
    "forEach": {
      "type": "object", "additionalProperties": false, "required": ["key", "in"],
      "properties": {"key": {"$ref": "#/$defs/identifier"}, "value": {"$ref": "#/$defs/identifier"}, "in": {"type": "string", "minLength": 1, "maxLength": 1024}}
    },
    "component": {
      "type": "object", "additionalProperties": false, "required": ["name", "resources"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}, "resources": {"$ref": "#/$defs/resources"}}
    },
    "componentUse": {
      "type": "object", "additionalProperties": false, "required": ["name", "componentRef"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "componentRef": {"$ref": "#/$defs/name"}, "arguments": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "array"]}}, "when": {"type": "string"}, "forEach": {"$ref": "#/$defs/forEach"}}
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "isolationClass": {"enum": ["process", "sandboxedContainer", "virtualMachine"]},
        "capabilities": {"type": "array", "items": {"type": "string", "maxLength": 256}, "uniqueItems": true, "maxItems": 128},
        "targetSelector": {"type": "object", "additionalProperties": {"type": "string"}, "maxProperties": 32}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "networks": {"type": "array", "items": {"$ref": "#/$defs/network"}, "maxItems": 128},
        "volumes": {"type": "array", "items": {"$ref": "#/$defs/volume"}, "maxItems": 128},
        "vms": {"type": "array", "items": {"$ref": "#/$defs/vm"}, "maxItems": 256},
        "containers": {"type": "array", "items": {"$ref": "#/$defs/container"}, "maxItems": 256},
        "accessEndpoints": {"type": "array", "items": {"$ref": "#/$defs/access"}, "maxItems": 256}
      }
    },
    "common": {
      "type": "object",
      "properties": {
        "name": {"$ref": "#/$defs/name"}, "when": {"type": "string", "maxLength": 1024},
        "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/ref"}, "uniqueItems": true, "maxItems": 128},
        "forEach": {"$ref": "#/$defs/forEach"},
        "labels": {"type": "object", "additionalProperties": {"type": "string"}, "maxProperties": 32}
      }
    },
    "egress": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"enum": ["deny", "restricted", "allow"]}, "destinations": {"type": "array", "items": {"type": "string"}, "maxItems": 128}}
    },
    "network": {
      "allOf": [
        {"$ref": "#/$defs/common"},
        {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {
          "name": {"$ref": "#/$defs/name"}, "kind": {"enum": ["isolated", "external"], "default": "isolated"},
          "ipv4Cidr": {"type": "string"}, "ipv6Cidr": {"type": "string"}, "ipam": {"enum": ["none", "static", "providerManaged"]},
          "mtu": {"type": "integer", "minimum": 576, "maximum": 9216}, "egress": {"$ref": "#/$defs/egress"},
          "when": {"type": "string"}, "forEach": {"$ref": "#/$defs/forEach"}, "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/ref"}}, "labels": {"type": "object", "additionalProperties": {"type": "string"}}
        }}
      ]
    },
    "volume": {
      "type": "object", "additionalProperties": false, "required": ["name", "size"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"}, "persistence": {"enum": ["ephemeral", "persistent"]}, "snapshot": {"type": "boolean"}, "when": {"type": "string"}, "forEach": {"$ref": "#/$defs/forEach"}, "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}
    },
    "compute": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "memory"],
      "properties": {"cpu": {"type": "number", "exclusiveMinimum": 0, "maximum": 128}, "memory": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi)$"}, "architecture": {"enum": ["amd64", "arm64"]}}
    },
    "interface": {
      "type": "object", "additionalProperties": false, "required": ["networkRef"],
      "properties": {"networkRef": {"$ref": "#/$defs/ref"}, "ipv4": {"type": "string"}, "ipv6": {"type": "string"}, "mac": {"type": "string", "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$"}, "when": {"type": "string", "maxLength": 1024}}
    },
    "mount": {
      "type": "object", "additionalProperties": false, "required": ["volumeRef", "path"],
      "properties": {"volumeRef": {"$ref": "#/$defs/ref"}, "path": {"type": "string", "minLength": 1}, "readOnly": {"type": "boolean"}}
    },
    "provisioning": {
      "type": "object", "additionalProperties": false, "required": ["method"],
      "properties": {"method": {"enum": ["cloudInit", "ignition", "oci"]}, "artifactRef": {"type": "string"}, "files": {"type": "array", "items": {"type": "object"}, "maxItems": 128}}
    },
    "vm": {
      "type": "object", "additionalProperties": false, "required": ["name", "imageRef", "compute"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "imageRef": {"type": "string"}, "osFamily": {"enum": ["linux", "windows", "other"]}, "compute": {"$ref": "#/$defs/compute"}, "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}, "maxItems": 16}, "mounts": {"type": "array", "items": {"$ref": "#/$defs/mount"}}, "provisioning": {"$ref": "#/$defs/provisioning"}, "lifecycle": {"type": "object"}, "when": {"type": "string"}, "forEach": {"$ref": "#/$defs/forEach"}, "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}
    },
    "envValue": {
      "oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": false, "required": ["secretRef"], "properties": {"secretRef": {"type": "object", "required": ["source", "name", "key"], "properties": {"source": {"type": "string"}, "name": {"type": "string"}, "key": {"type": "string"}}}}}]
    },
    "publishedPort": {
      "type": "object", "additionalProperties": false, "required": ["name", "port", "exposure"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}, "protocol": {"enum": ["tcp", "udp"]}, "exposure": {"enum": ["host", "public", "proxied"]}, "externalPort": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "container": {
      "type": "object", "additionalProperties": false, "required": ["name", "image", "compute"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "image": {"type": "string"}, "compute": {"$ref": "#/$defs/compute"}, "isolation": {"enum": ["process", "sandboxedContainer", "virtualMachine"]}, "realizationPreference": {"type": "array", "items": {"enum": ["native", "sandboxed", "viaVM"]}, "uniqueItems": true}, "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}}, "mounts": {"type": "array", "items": {"$ref": "#/$defs/mount"}}, "environment": {"type": "object", "additionalProperties": {"$ref": "#/$defs/envValue"}}, "command": {"type": "array", "items": {"type": "string"}}, "args": {"type": "array", "items": {"type": "string"}}, "publishedPorts": {"type": "array", "items": {"$ref": "#/$defs/publishedPort"}}, "when": {"type": "string"}, "forEach": {"$ref": "#/$defs/forEach"}, "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}
    },
    "access": {
      "type": "object", "additionalProperties": false, "required": ["name", "targetRef", "methods"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "targetRef": {"$ref": "#/$defs/ref"}, "methods": {"type": "array", "items": {"enum": ["ssh", "browserTerminal", "vnc", "spice", "serial", "rdp", "containerExec", "kubernetesExec", "providerNative"]}, "uniqueItems": true}, "when": {"type": "string"}, "forEach": {"$ref": "#/$defs/forEach"}, "dependsOn": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["name", "type", "value"],
      "properties": {"name": {"$ref": "#/$defs/name"}, "type": {"enum": ["string", "integer", "boolean", "url", "ip"]}, "value": {"type": "string", "maxLength": 1024}, "sensitive": {"type": "boolean"}}
    },
    "providerOverride": {
      "type": "object", "additionalProperties": false, "required": ["apiVersion", "spec"],
      "properties": {"apiVersion": {"type": "string", "pattern": "^provider\\.labcentral\\.io/[a-z0-9-]+/v[0-9]+(alpha[0-9]+|beta[0-9]+)?$"}, "spec": {"type": "object"}}
    }
  }
}
