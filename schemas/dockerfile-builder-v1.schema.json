{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labcentral.io/schemas/dockerfile-builder-v1.schema.json",
  "title": "labcentral.dockerfile.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["dockerfile"],
  "properties": {
    "dockerfile": {"type": "string", "minLength": 1, "maxLength": 240},
    "target": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"}
  }
}
