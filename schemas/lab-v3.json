{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "description": {
      "type": "string"
    },
    "extensions": {
      "additionalProperties": true,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
      },
      "type": "object"
    },
    "images": {
      "additionalProperties": {
        "additionalProperties": false,
        "allOf": [
          {
            "else": {
              "properties": {
                "build": {
                  "not": {
                    "required": [
                      "script"
                    ]
                  },
                  "required": [
                    "playbook"
                  ]
                }
              }
            },
            "if": {
              "properties": {
                "os": {
                  "const": "windows"
                }
              },
              "required": [
                "os"
              ]
            },
            "then": {
              "properties": {
                "build": {
                  "not": {
                    "required": [
                      "playbook"
                    ]
                  },
                  "required": [
                    "script"
                  ]
                }
              }
            }
          }
        ],
        "properties": {
          "base": {
            "pattern": "^[a-z][a-z0-9.-]{0,63}$",
            "type": "string"
          },
          "build": {
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "playbook"
                ]
              },
              {
                "required": [
                  "script"
                ]
              }
            ],
            "properties": {
              "files": {
                "items": {
                  "pattern": "^[a-zA-Z0-9_./-]+$",
                  "type": "string"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "playbook": {
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_./-]+$",
                "type": "string"
              },
              "script": {
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_./-]+\\.ps1$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "extensions": {
            "additionalProperties": true,
            "propertyNames": {
              "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
            },
            "type": "object"
          },
          "os": {
            "default": "linux",
            "enum": [
              "linux",
              "windows"
            ],
            "type": "string"
          },
          "platform": {
            "additionalProperties": false,
            "properties": {
              "aws": {
                "additionalProperties": false,
                "properties": {
                  "buildInstanceType": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "proxmox": {
                "additionalProperties": false,
                "properties": {},
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "base"
        ],
        "type": "object"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,47}$",
        "type": "string"
      },
      "type": "object"
    },
    "inputs": {
      "additionalProperties": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "string"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "maxLength": 4096,
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "integer"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "maximum": 9223372036854775807,
                  "minimum": -9223372036854775808,
                  "type": "integer"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "boolean"
                }
              }
            },
            "then": {
              "properties": {
                "default": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "required": {
                  "const": true
                }
              },
              "required": [
                "required"
              ]
            },
            "then": {
              "not": {
                "required": [
                  "default"
                ]
              }
            }
          }
        ],
        "properties": {
          "default": {},
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "type": {
            "enum": [
              "string",
              "integer",
              "boolean"
            ],
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "type": "object"
      },
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,47}$",
        "type": "string"
      },
      "type": "object"
    },
    "machines": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "access": {
            "items": {
              "enum": [
                "ssh",
                "desktop"
              ]
            },
            "type": "array",
            "uniqueItems": true
          },
          "cpu": {
            "maximum": 64,
            "minimum": 1,
            "type": "integer"
          },
          "disk": {
            "pattern": "^([1-9][0-9]*)(Mi|Gi)$",
            "type": "string"
          },
          "extensions": {
            "additionalProperties": true,
            "propertyNames": {
              "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
            },
            "type": "object"
          },
          "forwarding": {
            "type": "boolean"
          },
          "hostnamePeers": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "items": {
                  "pattern": "^[a-z][a-z0-9-]{0,47}$",
                  "type": "string"
                },
                "type": "array",
                "uniqueItems": true
              }
            ]
          },
          "image": {
            "pattern": "^[a-z][a-z0-9-]{0,47}$",
            "type": "string"
          },
          "memory": {
            "pattern": "^([1-9][0-9]*)(Mi|Gi)$",
            "type": "string"
          },
          "nics": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "address": {
                  "maximum": 250,
                  "minimum": 4,
                  "type": "integer"
                },
                "network": {
                  "pattern": "^[a-z][a-z0-9-]{0,47}$",
                  "type": "string"
                }
              },
              "required": [
                "network"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "platform": {
            "additionalProperties": false,
            "properties": {
              "aws": {
                "additionalProperties": false,
                "properties": {
                  "cpuCredits": {
                    "enum": [
                      "standard",
                      "unlimited"
                    ],
                    "type": "string"
                  },
                  "instanceType": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "volume": {
                    "additionalProperties": false,
                    "properties": {
                      "iops": {
                        "maximum": 16000,
                        "minimum": 3000,
                        "type": "integer"
                      },
                      "throughput": {
                        "maximum": 1000,
                        "minimum": 125,
                        "type": "integer"
                      },
                      "type": {
                        "enum": [
                          "gp3"
                        ],
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                },
                "type": "object"
              },
              "proxmox": {
                "additionalProperties": false,
                "properties": {
                  "cpuType": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "memoryBalloon": {
                    "type": "boolean"
                  },
                  "nicModel": {
                    "enum": [
                      "virtio",
                      "e1000",
                      "e1000e",
                      "vmxnet3",
                      "rtl8139"
                    ],
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          }
        },
        "required": [
          "image",
          "cpu",
          "memory",
          "disk"
        ],
        "type": "object"
      },
      "maxProperties": 32,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,47}$",
        "type": "string"
      },
      "type": "object"
    },
    "name": {
      "pattern": "^[a-z][a-z0-9-]{0,47}$",
      "type": "string"
    },
    "networks": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "cidr": {
            "minLength": 1,
            "type": "string"
          },
          "egress": {
            "default": "none",
            "enum": [
              "none",
              "internet"
            ],
            "type": "string"
          },
          "extensions": {
            "additionalProperties": true,
            "propertyNames": {
              "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,47}$",
        "type": "string"
      },
      "type": "object"
    },
    "platforms": {
      "items": {
        "enum": [
          "aws",
          "proxmox"
        ]
      },
      "type": "array",
      "uniqueItems": true
    },
    "version": {
      "const": 3,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "name",
    "images",
    "machines"
  ],
  "title": "LabCentral v3 lab source",
  "type": "object"
}
