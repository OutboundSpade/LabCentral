{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labcentral.io/schemas/vm-builder-binding-v1.schema.json",
  "title": "Pinned disposable VM worker",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileSHA256", "workerSHA256"],
  "properties": {
    "profileSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "workerSHA256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
