{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/proxmox-t3-smoke-profile-v1.schema.json",
  "title": "LabCentral Proxmox credentialed T3 smoke profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runID",
    "targetID",
    "instanceID",
    "networkResourceID",
    "vmResourceID",
    "networkCIDR",
    "guestIPv4",
    "imageRepository",
    "imageDigest",
    "templateAlias",
    "storageAlias",
    "networkAlias",
    "expectedVMID",
    "expectedVLAN",
    "cpuMillis",
    "memoryBytes"
  ],
  "properties": {
    "schemaVersion": {
      "const": "labcentral.proxmox-t3-smoke-profile/v1"
    },
    "runID": {
      "$ref": "#/$defs/stableID"
    },
    "targetID": {
      "$ref": "#/$defs/stableID"
    },
    "instanceID": {
      "$ref": "#/$defs/stableID"
    },
    "networkResourceID": {
      "$ref": "#/$defs/stableID"
    },
    "vmResourceID": {
      "$ref": "#/$defs/stableID"
    },
    "networkCIDR": {
      "type": "string",
      "minLength": 9,
      "maxLength": 18
    },
    "guestIPv4": {
      "type": "string",
      "minLength": 7,
      "maxLength": 15
    },
    "imageRepository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "imageDigest": {
      "$ref": "#/$defs/sha256"
    },
    "templateAlias": {
      "$ref": "#/$defs/alias"
    },
    "storageAlias": {
      "$ref": "#/$defs/alias"
    },
    "networkAlias": {
      "$ref": "#/$defs/alias"
    },
    "expectedVMID": {
      "type": "integer",
      "minimum": 100,
      "maximum": 999999999
    },
    "expectedVLAN": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4094
    },
    "cpuMillis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128000
    },
    "memoryBytes": {
      "type": "integer",
      "minimum": 16777216,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "stableID": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
