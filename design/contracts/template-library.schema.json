{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/template-library.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "templates"
  ],
  "properties": {
    "apiVersion": {
      "const": "labcentral.library/v1"
    },
    "templates": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "name",
          "root"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
