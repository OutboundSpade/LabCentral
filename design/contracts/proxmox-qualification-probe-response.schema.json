{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/proxmox-qualification-probe-response-v1.schema.json",
  "title": "LabCentral Proxmox qualification probe response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runID", "nonce", "agentImageDigest", "startedAt", "completedAt", "results"],
  "properties": {
    "schemaVersion": {"const": "labcentral.proxmox-qualification-probe-response/v1"},
    "runID": {"$ref": "#/$defs/stableID"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "agentImageDigest": {"$ref": "#/$defs/sha256"},
    "startedAt": {"$ref": "#/$defs/utcSecond"},
    "completedAt": {"$ref": "#/$defs/utcSecond"},
    "results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"$ref": "#/$defs/intendedResult"},
        {"$ref": "#/$defs/managementResult"},
        {"$ref": "#/$defs/crossInstanceResult"}
      ],
      "items": false
    }
  },
  "$defs": {
    "stableID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "utcSecond": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "observationProperties": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "endpointDigest", "attempts", "successes"],
      "properties": {
        "kind": {"enum": ["intended_segment", "management", "cross_instance"]},
        "endpointDigest": {"$ref": "#/$defs/sha256"},
        "attempts": {"type": "integer", "minimum": 3, "maximum": 10},
        "successes": {"type": "integer", "minimum": 0, "maximum": 10}
      }
    },
    "intendedResult": {
      "allOf": [
        {"$ref": "#/$defs/observationProperties"},
        {"type": "object", "properties": {"kind": {"const": "intended_segment"}}}
      ]
    },
    "managementResult": {
      "allOf": [
        {"$ref": "#/$defs/observationProperties"},
        {"type": "object", "properties": {"kind": {"const": "management"}}}
      ]
    },
    "crossInstanceResult": {
      "allOf": [
        {"$ref": "#/$defs/observationProperties"},
        {"type": "object", "properties": {"kind": {"const": "cross_instance"}}}
      ]
    }
  }
}
