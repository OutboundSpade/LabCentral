{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/proxmox-cleanup-envelope.schema.json",
  "title": "Signed Proxmox cleanup authorization",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": "labcentral.proxmox-cleanup/v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        },
        "validUntil": {
          "type": "string",
          "format": "date-time"
        },
        "targetID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "installationID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "instanceID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "resourceID": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "configurationDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "inventoryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "providerBinaryDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "ownershipDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "issuedAt",
        "validUntil",
        "targetID",
        "installationID",
        "instanceID",
        "resourceID",
        "configurationDigest",
        "inventoryDigest",
        "providerBinaryDigest",
        "ownershipDigest"
      ],
      "description": "Runtime additionally requires a positive validity interval no longer than 24 hours and exact current target/resource bindings."
    },
    "keyID": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "grant",
    "keyID",
    "signature"
  ]
}
