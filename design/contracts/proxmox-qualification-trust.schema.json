{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/proxmox-qualification-trust-v1.schema.json",
  "title": "LabCentral Proxmox qualification reviewer trust policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "maxEvidenceAgeSeconds", "keys"],
  "properties": {
    "schemaVersion": {
      "const": "labcentral.proxmox-qualification-trust/v1"
    },
    "maxEvidenceAgeSeconds": {
      "type": "integer",
      "minimum": 300,
      "maximum": 2592000
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyID", "publicKey", "notBefore", "notAfter", "revoked"],
        "properties": {
          "keyID": {"$ref": "#/$defs/stableID"},
          "publicKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "notBefore": {"$ref": "#/$defs/timestamp"},
          "notAfter": {"$ref": "#/$defs/timestamp"},
          "revoked": {"type": "boolean"}
        }
      }
    }
  },
  "$defs": {
    "stableID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}
