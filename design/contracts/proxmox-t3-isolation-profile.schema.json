{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/proxmox-t3-isolation-profile-v1.schema.json",
  "title": "LabCentral Proxmox credentialed T3 isolation profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runID",
    "targetID",
    "sourceInstanceID",
    "crossInstanceID",
    "sourceNetworkResourceID",
    "crossNetworkResourceID",
    "sourceVMResourceID",
    "peerVMResourceID",
    "crossVMResourceID",
    "sourceNetworkCIDR",
    "crossNetworkCIDR",
    "sourceGuestIPv4",
    "peerGuestIPv4",
    "crossGuestIPv4",
    "imageRepository",
    "imageDigest",
    "templateAlias",
    "storageAlias",
    "networkAlias",
    "expectedVMIDs",
    "expectedVLANs",
    "cpuMillis",
    "memoryBytes",
    "probe"
  ],
  "properties": {
    "schemaVersion": {"const": "labcentral.proxmox-t3-isolation-profile/v1"},
    "runID": {"$ref": "#/$defs/stableID"},
    "targetID": {"$ref": "#/$defs/stableID"},
    "sourceInstanceID": {"$ref": "#/$defs/stableID"},
    "crossInstanceID": {"$ref": "#/$defs/stableID"},
    "sourceNetworkResourceID": {"$ref": "#/$defs/stableID"},
    "crossNetworkResourceID": {"$ref": "#/$defs/stableID"},
    "sourceVMResourceID": {"$ref": "#/$defs/stableID"},
    "peerVMResourceID": {"$ref": "#/$defs/stableID"},
    "crossVMResourceID": {"$ref": "#/$defs/stableID"},
    "sourceNetworkCIDR": {"$ref": "#/$defs/ipv4CIDR"},
    "crossNetworkCIDR": {"$ref": "#/$defs/ipv4CIDR"},
    "sourceGuestIPv4": {"$ref": "#/$defs/ipv4"},
    "peerGuestIPv4": {"$ref": "#/$defs/ipv4"},
    "crossGuestIPv4": {"$ref": "#/$defs/ipv4"},
    "imageRepository": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\u0000\\r\\n]+$"},
    "imageDigest": {"$ref": "#/$defs/sha256"},
    "templateAlias": {"$ref": "#/$defs/alias"},
    "storageAlias": {"$ref": "#/$defs/alias"},
    "networkAlias": {"$ref": "#/$defs/alias"},
    "expectedVMIDs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 100, "maximum": 999999999}
    },
    "expectedVLANs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1, "maximum": 4094}
    },
    "cpuMillis": {"type": "integer", "minimum": 1, "maximum": 128000},
    "memoryBytes": {"type": "integer", "minimum": 16777216, "maximum": 9007199254740991},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentOrigin", "intendedPort", "managementAddress", "crossInstancePort", "attempts", "timeoutMillis"],
      "properties": {
        "agentOrigin": {"type": "string", "minLength": 15, "maxLength": 64, "pattern": "^https://([0-9]{1,3}\\.){3}[0-9]{1,3}:[0-9]{4,5}$"},
        "intendedPort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "managementAddress": {"type": "string", "minLength": 9, "maxLength": 21, "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}:[0-9]{1,5}$"},
        "crossInstancePort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "attempts": {"type": "integer", "minimum": 3, "maximum": 10},
        "timeoutMillis": {"type": "integer", "minimum": 100, "maximum": 5000}
      }
    }
  },
  "$defs": {
    "stableID": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"},
    "alias": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ipv4": {"type": "string", "minLength": 7, "maxLength": 15},
    "ipv4CIDR": {"type": "string", "minLength": 9, "maxLength": 18}
  }
}
