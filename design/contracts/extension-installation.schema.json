{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/extension-installation.schema.json",
  "title": "LabCentral extension installation v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "labcentral.io/installation/v2"
    },
    "pluginRoot": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "mode": {
            "enum": [
              "local",
              "attach"
            ]
          },
          "runtimeDirectory": {
            "type": "string"
          },
          "tokenFile": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "grantedPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 64,
            "minItems": 0,
            "uniqueItems": true
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                },
                "configFile": {
                  "type": "string"
                },
                "credentialFile": {
                  "type": "string"
                },
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "trustedLaptop": {
                      "type": "boolean"
                    },
                    "minimumMinor": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "requiredFeatures": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                      },
                      "maxItems": 128,
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "nativeCapabilities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                      },
                      "maxItems": 128,
                      "minItems": 0,
                      "uniqueItems": true
                    }
                  },
                  "required": []
                }
              },
              "required": [
                "id",
                "kind"
              ]
            },
            "maxItems": 64,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "manifest",
          "instanceId",
          "mode",
          "targets"
        ]
      },
      "maxItems": 32,
      "minItems": 0,
      "uniqueItems": true
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "mode": {
            "enum": [
              "local",
              "attach"
            ]
          },
          "runtimeDirectory": {
            "type": "string"
          },
          "tokenFile": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "grantedPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 64,
            "minItems": 0,
            "uniqueItems": true
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "contribution": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "targetIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          },
          "streamEndpoint": {
            "type": "string",
            "format": "uri"
          },
          "bindings": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "projectIds",
                "configuration"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "projectIds": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  }
                },
                "configuration": {
                  "type": "object"
                },
                "credentialFile": {
                  "type": "string",
                  "minLength": 1
                },
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "timeoutSeconds",
                    "cpuCount",
                    "memoryBytes",
                    "inputBytes",
                    "outputBytes",
                    "egress"
                  ],
                  "properties": {
                    "timeoutSeconds": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 86400
                    },
                    "cpuCount": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 256
                    },
                    "memoryBytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "inputBytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "outputBytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "egress": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "string",
                        "maxLength": 256
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "required": [
          "instanceId",
          "grantedPermissions"
        ]
      },
      "minItems": 0,
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "pluginRoot"
  ],
  "anyOf": [
    {
      "required": [
        "providers"
      ],
      "properties": {
        "providers": {
          "minItems": 1
        }
      }
    },
    {
      "required": [
        "extensions"
      ],
      "properties": {
        "extensions": {
          "minItems": 1
        }
      }
    }
  ]
}
