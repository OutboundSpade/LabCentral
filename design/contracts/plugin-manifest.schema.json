{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/plugin-manifest.schema.json",
  "title": "Explicit provider installation manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "labcentral.io/plugin-manifest/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "executable": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "protocolMajor": {
      "const": 1
    },
    "minimumProtocolMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0
    },
    "maximumProtocolMinor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "default": 0
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "providerKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "accessKinds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "accessMethods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "endpointSchemas": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "operatingSystems": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "architectures": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    },
    "requestedPermissions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      },
      "maxItems": 64,
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "id",
    "version",
    "executable",
    "sha256",
    "categories",
    "protocolMajor",
    "operatingSystems",
    "architectures"
  ]
}
