{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.labcentral.local/plugin-installation.schema.json",
  "title": "LabCentral provider installation v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "labcentral.io/installation/v1"
    },
    "pluginRoot": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "manifest": {
            "type": "string",
            "minLength": 1
          },
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "mode": {
            "enum": [
              "local",
              "attach"
            ]
          },
          "runtimeDirectory": {
            "type": "string"
          },
          "tokenFile": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "grantedPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 64,
            "minItems": 0,
            "uniqueItems": true
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                },
                "configFile": {
                  "type": "string"
                },
                "credentialFile": {
                  "type": "string"
                },
                "policy": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "trustedLaptop": {
                      "type": "boolean"
                    },
                    "minimumMinor": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "requiredFeatures": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                      },
                      "maxItems": 128,
                      "minItems": 0,
                      "uniqueItems": true
                    },
                    "nativeCapabilities": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
                      },
                      "maxItems": 128,
                      "minItems": 0,
                      "uniqueItems": true
                    }
                  },
                  "required": []
                }
              },
              "required": [
                "id",
                "kind"
              ]
            },
            "maxItems": 64,
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "manifest",
          "instanceId",
          "mode",
          "targets"
        ]
      },
      "maxItems": 32,
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "apiVersion",
    "pluginRoot",
    "providers"
  ]
}
