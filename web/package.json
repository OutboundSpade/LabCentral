{
  "name": "labcentral-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vite build && bun run normalize-build",
    "normalize-build": "bun ../tools/normalize_web_build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:browser": "node tests/startup.mjs",
    "generate:api": "cd .. && go run ./tools/openapi && cd web && openapi-typescript ../api/http/openapi.json -o src/lib/api.generated.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "daisyui": "5.7.27",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "svelte": "5.57.0",
    "svelte-check": "4.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0"
  },
  "overrides": {
    "cookie": "0.7.2"
  }
}
