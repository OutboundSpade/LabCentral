{
  "name": "labcentral-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node ../tools/sync_theme.mjs --check && vite build && bun run normalize-build",
    "normalize-build": "bun ../tools/normalize_web_build.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:extensions": "node tests/extensions.mjs",
    "test:browser": "node tests/startup.mjs && node tests/classroom.mjs && node tests/features.mjs && node tests/operations.mjs && node tests/shared-console.mjs && node tests/administration.mjs",
    "generate:api": "cd .. && go run ./tools/openapi && cd web && openapi-typescript ../api/http/openapi.json -o src/lib/api.generated.ts",
    "test:cache": "bun test tests/query.test.ts tests/schema.test.ts tests/extension-bridge.test.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.1",
    "daisyui": "5.7.27",
    "openapi-typescript": "7.13.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "@novnc/novnc": "1.7.0",
    "@tanstack/query-core": "5.102.8",
    "@tanstack/svelte-query": "6.1.48",
    "apexcharts": "7.4.0"
  },
  "overrides": {
    "cookie": "0.7.2",
    "js-yaml": "4.3.2"
  }
}
